---
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { offer } from "../lib/offer";

// Prices of the API contract, the standard ones, and the launch offer on
// the yearly plan. The checkout answer carries the amount really charged
// and the key panel shows it before anyone pays.
const plans = [
  { id: "month", name: "1 month", days: 31, price: 5, perMonth: "5 € a month" },
  { id: "half_year", name: "6 months", days: 183, price: 24, perMonth: "4 € a month" },
  { id: "year", name: "1 year", days: 366, price: 36, perMonth: "3 € a month", offer: offer.price },
] as const;

// What the server does, in the order a buyer meets it.
const does = [
  {
    icon: "shield-alert",
    title: "Tells you when coins move",
    body: "One alert when coins arrive or leave and the transaction enters the mempool, a second one when it is in a block.",
  },
  {
    icon: "timer",
    title: "Warns you before a timelock opens",
    body: "30 days, 7 days and 1 day before a recovery path becomes spendable, then again the day it opens.",
  },
  {
    icon: "bell",
    title: "Reaches you where you are",
    body: "ntfy, Telegram and e-mail name the wallet and say what happened. A webhook, signed with HMAC-SHA256, carries the whole event to a machine of yours.",
  },
  {
    icon: "eye",
    title: "Watches around the clock",
    body: "From its own Bitcoin node, every address of the wallets you registered, present and future, whether your apps are open or not.",
  },
  {
    icon: "layers",
    title: "Covers all your wallets",
    body: "Up to 21 wallets on one Premium key, single-sig, multisig, miniscript and single addresses alike, and every device where you type that key.",
  },
  {
    icon: "lock",
    title: "Never a private key",
    body: "The server takes the descriptors and single addresses the app already holds, and nothing else. It can see coins move and cannot move them.",
  },
] as const;

const faq = [
  {
    q: "I lost my Premium key. Can you find it?",
    a: "No. We store a hash of the Premium key, the way a website stores a password, and nobody can rebuild the key from it, us included. When the key is gone, the time on it is gone with it. Write it down the moment it appears, before you pay, and keep it in your password manager. Anyone who has the key can use the time you paid for.",
  },
  {
    q: "What exactly does the server see?",
    a: "What a watch-only wallet sees: the descriptors and single addresses you register, the addresses the descriptors derive, and the coins and transactions on them. Plus the channels you add. Never a private key, no name, no IP address. Remove a wallet from the app and the server deletes its descriptor, its addresses and its alerts.",
  },
  {
    q: "Can I cancel, or get a refund?",
    a: "There is nothing to cancel: you prepay time, and it runs out on its own. The service starts the moment your payment is confirmed, so the payment is final, unless we discontinue the service. The Terms of Sale say it in full.",
  },
  {
    q: "Which wallets can be watched?",
    a: "Any mainnet wallet in Gerfaut: single-sig, multisig, miniscript policies with timelocks, and a wallet added from a single address.",
  },
  {
    q: "Are there limits?",
    a: "One Premium key watches up to 21 wallets and reaches up to 10 channels. Test messages and channel confirmation codes: five an hour. E-mail alerts: 20 a day; past that, the remaining e-mails go out the next day, and ntfy, Telegram and webhooks are not affected.",
  },
  {
    q: "Can a webhook point at a machine on my own network?",
    a: "Only if the internet can reach it. A loopback, private, link-local or carrier-grade NAT address is refused, a 192.168 address and a Tailscale 100.64 address included, when you add the channel and again at each delivery. Give the receiver a public name, or take ntfy: there your machine subscribes to a topic instead of waiting to be called.",
  },
  {
    q: "What does the server keep about me?",
    a: "A hash of your Premium key, the descriptors and addresses you register with the names you gave them, and the channels you add. No IP address, no request log, no e-mail unless you add one as a channel, no name: there is no account.",
  },
  {
    q: "Can I run the server myself?",
    a: "Not yet. A watcher on your own node, so that nothing leaves your home, is planned for a later version.",
  },
] as const;
---

<Base
  title="Gerfaut Premium · Alerts for your cold storage"
  description="Gerfaut Premium is a server that watches your Bitcoin wallets around the clock and tells you within seconds when coins move, over ntfy, Telegram, e-mail or webhook. From 3 € a month, paid in bitcoin, no account."
>
  <section class="dark-island bg-background pt-16 pb-16 text-text md:pt-24 md:pb-24">
    <div class="site-container">
      <div class="mx-auto max-w-3xl text-center">
        <span class="pill-premium">
          <Icon name="gem" size={12} />
          Premium
        </span>
        <h1
          class="mt-5 font-display text-[2.25rem] leading-[1.05] font-semibold tracking-[-0.03em] sm:text-[2.75rem] lg:text-hero"
        >
          The apps watch. Premium wakes you up.
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-lg text-muted">
          The apps are free and complete on their own, live notifications
          included. Premium adds a server that watches the wallets you choose,
          around the clock, and tells you within seconds when coins move.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href="#buy" class="btn btn-premium btn-wide">Get Premium</a>
          <a href="#renew" class="btn btn-primary">Add time to a Premium key</a>
        </div>
        <p class="mt-5 text-sm text-muted">
          From 3&nbsp;€ a month &middot; Paid in bitcoin &middot; No account
        </p>
        {
          offer.active && (
            <p class="mt-5 flex justify-center">
              <span class="offer-badge">
                <Icon name="gem" size={16} />
                <span>
                  Launch offer: <strong>&minus;{offer.percent}&nbsp;%</strong> on the first year, until {offer.until}
                </span>
              </span>
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="does-heading">
    <div class="site-container">
      <div class="mx-auto max-w-2xl text-center">
        <h2 id="does-heading" class="section-title">What Premium does</h2>
        <p class="mt-4 text-lg text-muted">
          Hand the server a descriptor, pick your channels, and it takes it
          from there.
        </p>
      </div>
      <ul class="mt-12 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
        {
          does.map((item) => (
            <li class="card p-5 md:p-6">
              <span class="flex h-9 w-9 items-center justify-center rounded-md bg-premium-surface text-premium">
                <Icon name={item.icon} size={18} />
              </span>
              <h3 class="mt-4 font-display text-[1.0625rem] font-semibold">
                {item.title}
              </h3>
              <p class="mt-1.5 text-sm text-muted">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section
    id="buy"
    class="section scroll-mt-20 border-t border-border"
    aria-labelledby="buy-heading"
  >
    <div class="site-container">
      <div class="mx-auto max-w-2xl text-center">
        <h2 id="buy-heading" class="section-title">Get Premium</h2>
        <p class="mt-4 text-lg text-muted">
          One plan, every service. Prices in euro, paid in bitcoin through
          Ark, Lightning or on-chain, at the rate the checkout shows.
          {offer.active && (
            <>
              {" "}Until {offer.until} inclusive, the first year is {offer.price}&nbsp;€
              instead of {offer.standard}&nbsp;€.
            </>
          )}
        </p>
      </div>

      <form id="buy-form" novalidate class="mt-10">
        <fieldset>
          <legend class="sr-only">Plan</legend>
          <div class="grid gap-3 sm:grid-cols-3 lg:gap-4">
            {
              plans.map((plan) => (
                <label class="plan plan-premium">
                  <input
                    type="radio"
                    name="plan"
                    value={plan.id}
                    class="sr-only"
                    checked={plan.id === "year"}
                  />
                  <span class="flex w-full items-start justify-between gap-4 p-5">
                    <span>
                      <span class="block text-label tracking-[0.04em] text-muted uppercase">
                        {plan.name}
                      </span>
                      <span class="mt-3 flex flex-wrap items-baseline gap-x-2 text-amount tabular-nums">
                        {"offer" in plan && offer.active ? (
                          <>
                            <span class="price-old">{plan.price}&nbsp;€</span>
                            <span>{plan.offer}&nbsp;€</span>
                          </>
                        ) : (
                          <span>{plan.price}&nbsp;€</span>
                        )}
                      </span>
                      <span class="mt-1 block text-sm text-muted">
                        {plan.days} days &middot; {plan.perMonth}
                      </span>
                    </span>
                    <span class="plan-dot" aria-hidden="true">
                      <Icon name="check" size={12} />
                    </span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <p class="mt-4 text-center text-sm text-muted">
          Paid time adds to the end of the time you already have.
        </p>

        <div id="buy-states" class="mt-8" aria-live="polite">
          <div data-state="idle">
            <div class="flex flex-col items-center gap-3">
              <button
                type="submit"
                id="buy-button"
                class="btn btn-premium btn-wide"
                data-label="Get Premium"
                data-busy="Creating your key…"
              >
                Get Premium
              </button>
              <p class="text-center text-sm text-muted">
                By paying you accept the
                <a href="/terms" class="link">Terms of Sale</a>.
              </p>
            </div>
            <div id="buy-note" class="note note-pending mx-auto mt-5 max-w-xl" hidden>
              <Icon name="info" size={16} />
              <p></p>
            </div>
          </div>

          <div data-state="key" hidden class="card mx-auto max-w-2xl p-5 sm:p-6">
            <h3 id="key-heading" tabindex="-1" class="text-h2 font-display">
              Your Premium key
            </h3>
            <p class="mt-1 text-sm text-muted">
              Shown once, before you pay. Save it now.
            </p>
            <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center">
              <p
                id="key-value"
                class="font-data m-0 min-w-0 flex-1 rounded-sm bg-sunken px-4 py-3 text-[1.375rem] leading-tight tracking-[0.04em] break-words select-all sm:text-[1.75rem]"
              >
              </p>
              <button type="button" id="key-copy" class="btn btn-primary shrink-0">
                <Icon name="copy" size={16} class="key-copy-idle" />
                <Icon name="check" size={16} class="key-copy-done" />
                <span id="key-copy-label">Copy</span>
              </button>
            </div>
            <p id="key-copied" class="sr-only" role="status"></p>
            <div class="note note-alert mt-4">
              <Icon name="triangle-alert" size={16} />
              <p>
                This key is the only proof of your purchase. We keep a hash of
                it, never the key, so nobody can recover or re-issue it, us
                included. Write it down or put it in your password manager
                before you pay.
              </p>
            </div>
            <dl class="mt-5 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-[auto_1fr]">
              <dt class="text-muted">Plan</dt>
              <dd id="key-plan" class="m-0 font-medium"></dd>
              <dt class="text-muted">Price</dt>
              <dd class="m-0 flex flex-wrap items-center gap-2 font-medium">
                <span id="key-amount" class="tabular-nums"></span>
                <span id="key-offer" class="pill pill-neutral text-text" hidden>
                  Launch offer
                </span>
                <span id="key-standard" class="font-normal text-muted"></span>
              </dd>
            </dl>
            <p class="mt-3 text-sm text-muted">
              You pay in bitcoin at the rate the checkout page shows. The
              checkout stays open for one hour.
            </p>
            <div class="mt-5 border-t border-border pt-5">
              <label class="flex min-h-11 cursor-pointer items-center gap-3 text-sm">
                <input type="checkbox" id="key-saved" class="checkbox" />
                <span>I wrote my key down</span>
              </label>
              <button
                type="button"
                id="key-continue"
                class="btn btn-primary mt-3"
                aria-disabled="true"
                aria-describedby="key-gate"
              >
                I saved my key, continue to payment
              </button>
              <p id="key-gate" class="mt-3 text-sm text-muted">
                The button opens once the box is ticked. The checkout opens in
                this tab. By paying you accept the
                <a href="/terms" class="link">Terms of Sale</a>.
              </p>
            </div>
          </div>

          <div data-state="soon" hidden class="card mx-auto max-w-xl p-5">
            <p class="font-medium">Premium opens soon</p>
            <p class="mt-1 text-sm text-muted">
              Payments are not open yet: Premium opens with the first public
              release of the apps. Nothing was created and nothing was
              charged. Follow the
              <a href="https://github.com/gerfaut-wallet" class="link"
                >GitHub repositories</a
              >
              to catch the opening.
            </p>
          </div>
        </div>
      </form>
    </div>
  </section>

  <section
    id="renew"
    class="scroll-mt-20 pb-16 md:pb-24"
    aria-labelledby="renew-heading"
  >
    <div class="site-container">
      <form id="renew-form" novalidate class="card p-5 sm:p-6 md:p-8">
        <h2 id="renew-heading" class="text-h1 font-display">
          Already have a Premium key? Add time
        </h2>
        <p class="mt-2 text-sm text-muted">
          The new time goes to the end of what you already have.
        </p>
        <div id="renew-paste" class="note note-neutral mt-5" hidden>
          <Icon name="copy" size={16} />
          <p>
            Paste your key here. If you came from the app, it is in your
            clipboard already.
          </p>
        </div>
        <div class="mt-5">
          <label for="renew-key" class="text-sm font-medium">Premium key</label>
          <input
            id="renew-key"
            name="key"
            type="text"
            class="field font-data mt-1.5"
            inputmode="text"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder="xxxx-xxxx-xxxx-xxxx"
          />
          <p id="renew-key-error" class="mt-1.5 text-sm font-medium" hidden></p>
        </div>
        <fieldset class="mt-5">
          <legend class="text-sm font-medium">Time to add</legend>
          <div class="mt-1.5 grid gap-2 sm:grid-cols-3">
            {
              plans.map((plan) => (
                <label class="choice">
                  <input
                    type="radio"
                    name="plan"
                    value={plan.id}
                    class="sr-only"
                    checked={plan.id === "month"}
                  />
                  <span class="tabular-nums">
                    {plan.name} &middot; {"offer" in plan && offer.active ? plan.offer : plan.price}&nbsp;€
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <div id="renew-states" class="mt-6" aria-live="polite">
          <div data-state="idle">
            <button
              type="submit"
              id="renew-button"
              class="btn btn-primary"
              data-label="Add time"
              data-busy="Opening the checkout…"
            >
              Add time
            </button>
            <p class="mt-3 text-sm text-muted">
              By paying you accept the
              <a href="/terms" class="link">Terms of Sale</a>.
            </p>
            <div id="renew-note" class="note note-pending mt-4" hidden>
              <Icon name="info" size={16} />
              <p></p>
            </div>
          </div>
          <div data-state="soon" hidden class="note note-neutral">
            <Icon name="info" size={16} />
            <p>
              Payments are not open yet: Premium opens with the first public
              release of the apps. Nothing was charged.
            </p>
          </div>
        </div>
      </form>
    </div>
  </section>

  <section class="section border-t border-border" aria-labelledby="faq-heading">
    <div class="site-container">
      <h2 id="faq-heading" class="section-title">Questions</h2>
      <dl class="mt-10 grid gap-x-12 gap-y-8 md:grid-cols-2">
        {
          faq.map((item) => (
            <div>
              <dt class="text-h2 font-display">{item.q}</dt>
              <dd class="m-0 mt-2 text-sm text-muted">{item.a}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-10 text-sm text-muted">
        Another question? Write to
        <a href="mailto:info@pandul.fr" class="link">info@pandul.fr</a>.
        The full conditions are in the
        <a href="/terms" class="link">Terms of Sale</a>.
      </p>
    </div>
  </section>
</Base>

<style is:global>
  .key-copy-done {
    display: none;
  }
  #key-copy[data-done] .key-copy-idle {
    display: none;
  }
  #key-copy[data-done] .key-copy-done {
    display: block;
  }
</style>

<script>
  const API = "https://api.gerfaut-wallet.com";
  // Standard prices, in euro. A lower amount from the API is a launch
  // offer, and the page says so next to the real figure.
  const STANDARD: Record<string, number> = { month: 5, half_year: 24, year: 36 };
  const NAMES: Record<string, string> = {
    month: "1 month",
    half_year: "6 months",
    year: "1 year",
  };
  // The key alphabet of the server: no l, o, 0 or 1.
  const KEY_SHAPE = /^[a-km-np-z2-9]{16}$/;

  type Checkout = {
    key: string | null;
    plan: string;
    days: number;
    amount_eur: number;
    charge_id: string;
    checkout_url: string;
  };
  type Failure = {
    kind: "offline" | "soon" | "busy" | "unknown-key" | "bad" | "server";
    message: string;
  };
  type Result = { ok: true; data: Checkout } | ({ ok: false } & Failure);

  async function checkout(body: { plan: string; key?: string }): Promise<Result> {
    let res: Response;
    try {
      res = await fetch(`${API}/v1/checkout`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(body),
      });
    } catch {
      return { ok: false, kind: "offline", message: "" };
    }
    const data = await res.json().catch(() => null);
    if (res.ok && data && typeof data.checkout_url === "string") {
      return { ok: true, data: data as Checkout };
    }
    const message = typeof data?.error === "string" ? data.error : "";
    if (res.status === 404) {
      const kind = /unknown key/i.test(message) ? "unknown-key" : "soon";
      return { ok: false, kind, message };
    }
    if (res.status === 429) return { ok: false, kind: "busy", message };
    if (res.status === 400) return { ok: false, kind: "bad", message };
    return { ok: false, kind: "server", message };
  }

  // The page only ever leaves for the checkout of our own Bark Pay
  // instance: the API names no other origin, so anything else is a fault
  // and gets the server note instead of a redirect.
  const CHECKOUT_ORIGIN = "https://pay.gerfaut-wallet.com";
  function safeUrl(url: string): string | null {
    try {
      const parsed = new URL(url);
      return parsed.origin === CHECKOUT_ORIGIN ? parsed.href : null;
    } catch {
      return null;
    }
  }

  function euros(amount: number): string {
    const text = Number.isInteger(amount) ? String(amount) : amount.toFixed(2);
    return `${text} €`;
  }

  function setState(region: HTMLElement, state: string) {
    for (const panel of region.querySelectorAll<HTMLElement>(":scope > [data-state]")) {
      panel.hidden = panel.dataset.state !== state;
    }
  }

  function busy(button: HTMLButtonElement, on: boolean) {
    button.disabled = on;
    button.textContent = (on ? button.dataset.busy : button.dataset.label) ?? "";
  }

  function note(box: HTMLElement, text: string) {
    const p = box.querySelector("p");
    if (p) p.textContent = text;
    box.hidden = false;
  }

  const OFFLINE =
    "Could not reach the Gerfaut server. Check your connection, then try again.";
  const BUSY =
    "Too many checkouts are being created right now. Wait a minute, then try again.";
  const SERVER =
    "The payment service did not answer. Nothing was charged. Try again in a moment.";

  // --- buying: mint a key, show it once, then leave for the checkout ---

  const buyForm = document.getElementById("buy-form") as HTMLFormElement | null;
  const buyStates = document.getElementById("buy-states");
  const buyButton = document.getElementById("buy-button") as HTMLButtonElement | null;
  const buyNote = document.getElementById("buy-note");
  const keyHeading = document.getElementById("key-heading");
  const keyValue = document.getElementById("key-value");
  const keyCopy = document.getElementById("key-copy") as HTMLButtonElement | null;
  const keyCopyLabel = document.getElementById("key-copy-label");
  const keyCopied = document.getElementById("key-copied");
  const keyPlan = document.getElementById("key-plan");
  const keyAmount = document.getElementById("key-amount");
  const keyOffer = document.getElementById("key-offer");
  const keyStandard = document.getElementById("key-standard");
  const keySaved = document.getElementById("key-saved") as HTMLInputElement | null;
  const keyContinue = document.getElementById("key-continue") as HTMLButtonElement | null;

  let checkoutUrl: string | null = null;
  let leaving = false;

  function showKey(data: Checkout) {
    const url = safeUrl(data.checkout_url);
    if (!data.key || !url || !buyStates || !buyForm) {
      if (buyNote) note(buyNote, SERVER);
      return;
    }
    checkoutUrl = url;
    if (keyValue) keyValue.textContent = data.key;
    if (keyPlan) {
      keyPlan.textContent = `${NAMES[data.plan] ?? data.plan} · ${data.days} days`;
    }
    const standard = STANDARD[data.plan];
    const offer = standard !== undefined && data.amount_eur < standard;
    if (keyAmount) keyAmount.textContent = euros(data.amount_eur);
    if (keyOffer) keyOffer.hidden = !offer;
    if (keyStandard) {
      keyStandard.textContent =
        offer && standard !== undefined ? `${euros(standard)} at the standard price` : "";
    }
    for (const radio of buyForm.querySelectorAll<HTMLInputElement>('input[name="plan"]')) {
      radio.disabled = true;
    }
    setState(buyStates, "key");
    keyHeading?.focus();
  }

  buyForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!buyButton || !buyStates) return;
    const plan = (new FormData(buyForm).get("plan") as string | null) ?? "year";
    if (buyNote) buyNote.hidden = true;
    busy(buyButton, true);
    const result = await checkout({ plan });
    busy(buyButton, false);
    if (result.ok) {
      showKey(result.data);
      return;
    }
    switch (result.kind) {
      case "soon":
        setState(buyStates, "soon");
        break;
      case "offline":
        if (buyNote) note(buyNote, OFFLINE);
        break;
      case "busy":
        if (buyNote) note(buyNote, BUSY);
        break;
      default:
        if (buyNote) note(buyNote, SERVER);
    }
  });

  let copyTimer: ReturnType<typeof setTimeout> | undefined;
  function flashCopy(text: string) {
    if (keyCopyLabel) keyCopyLabel.textContent = text;
    if (keyCopied) keyCopied.textContent = `${text}.`;
    keyCopy?.setAttribute("data-done", "");
    clearTimeout(copyTimer);
    copyTimer = setTimeout(() => {
      if (keyCopyLabel) keyCopyLabel.textContent = "Copy";
      keyCopy?.removeAttribute("data-done");
    }, 1500);
  }

  keyCopy?.addEventListener("click", async () => {
    const key = keyValue?.textContent?.trim() ?? "";
    if (!key) return;
    try {
      await navigator.clipboard.writeText(key);
      flashCopy("Copied");
    } catch {
      // No clipboard access: select the key so a manual copy is one keystroke.
      if (keyValue) {
        const range = document.createRange();
        range.selectNodeContents(keyValue);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      flashCopy("Selected, press copy");
    }
  });

  keySaved?.addEventListener("change", () => {
    keyContinue?.setAttribute("aria-disabled", String(!keySaved.checked));
  });

  keyContinue?.addEventListener("click", () => {
    if (!keySaved?.checked) {
      keySaved?.focus();
      return;
    }
    if (!checkoutUrl) return;
    leaving = true;
    window.location.assign(checkoutUrl);
  });

  // A minted key that was never saved is money on the floor: ask before
  // the tab closes on it. Leaving for the checkout is the one exception.
  window.addEventListener("beforeunload", (event) => {
    if (checkoutUrl && !leaving) {
      event.preventDefault();
      event.returnValue = "";
    }
  });

  // --- renewing: an existing key, straight to the checkout ---

  const renewForm = document.getElementById("renew-form") as HTMLFormElement | null;
  const renewStates = document.getElementById("renew-states");
  const renewButton = document.getElementById("renew-button") as HTMLButtonElement | null;
  const renewNote = document.getElementById("renew-note");
  const keyInput = document.getElementById("renew-key") as HTMLInputElement | null;
  const keyError = document.getElementById("renew-key-error");
  const renewPaste = document.getElementById("renew-paste");

  // Lowercase, only letters and digits, a dash every four: what the user
  // types or pastes, made canonical while the caret stays where it was.
  function formatKeyInput(input: HTMLInputElement) {
    const raw = input.value;
    const caret = input.selectionStart ?? raw.length;
    const typedBefore = raw.slice(0, caret).replace(/[^a-z0-9]/gi, "").length;
    const compact = raw.replace(/[^a-z0-9]/gi, "").toLowerCase().slice(0, 16);
    const formatted = compact.replace(/(.{4})(?=.)/g, "$1-");
    const symbols = Math.min(typedBefore, compact.length);
    const position = symbols + Math.floor(Math.max(symbols - 1, 0) / 4);
    input.value = formatted;
    input.setSelectionRange(position, position);
  }

  function fieldError(text: string | null) {
    if (!keyInput || !keyError) return;
    if (text) {
      keyError.textContent = text;
      keyError.hidden = false;
      keyInput.setAttribute("aria-invalid", "true");
      keyInput.setAttribute("aria-describedby", "renew-key-error");
      keyInput.focus();
    } else {
      keyError.hidden = true;
      keyInput.removeAttribute("aria-invalid");
      keyInput.removeAttribute("aria-describedby");
    }
  }

  keyInput?.addEventListener("input", () => {
    formatKeyInput(keyInput);
    if (renewPaste) renewPaste.hidden = true;
    if (keyError && !keyError.hidden) fieldError(null);
  });

  renewForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!keyInput || !renewButton || !renewStates) return;
    if (renewNote) renewNote.hidden = true;
    const compact = keyInput.value.replace(/-/g, "");
    if (!/^[a-z0-9]{16}$/.test(compact)) {
      fieldError("Enter the 16 characters of your key.");
      return;
    }
    if (!KEY_SHAPE.test(compact)) {
      fieldError(
        "This key contains a character keys never use (l, o, 0 or 1). Compare it with the one you saved.",
      );
      return;
    }
    const plan = (new FormData(renewForm).get("plan") as string | null) ?? "month";
    busy(renewButton, true);
    const result = await checkout({ plan, key: keyInput.value });
    busy(renewButton, false);
    if (result.ok) {
      const url = safeUrl(result.data.checkout_url);
      if (url) {
        leaving = true;
        window.location.assign(url);
        return;
      }
      if (renewNote) note(renewNote, SERVER);
      return;
    }
    switch (result.kind) {
      case "soon":
        setState(renewStates, "soon");
        break;
      case "unknown-key":
        fieldError("We do not know this Premium key. Check each character against the one you saved. If you have no key yet, get one with Get Premium above: a key is created when you buy it.");
        break;
      case "bad":
        fieldError(
          "That is not the shape of a key: 16 letters and digits, shown as xxxx-xxxx-xxxx-xxxx.",
        );
        break;
      case "offline":
        if (renewNote) note(renewNote, OFFLINE);
        break;
      case "busy":
        if (renewNote) note(renewNote, BUSY);
        break;
      default:
        if (renewNote) note(renewNote, SERVER);
    }
  });

  // Focus two frames after the page has loaded. On the first one the
  // browser applies the #renew anchor, and since a section cannot take
  // focus, that clears whatever had it, including a focus set earlier.
  function focusWhenLoaded(target: HTMLElement) {
    const go = () =>
      requestAnimationFrame(() =>
        requestAnimationFrame(() => target.focus({ preventScroll: true })),
      );
    if (document.readyState === "complete") go();
    else window.addEventListener("load", go, { once: true });
  }

  // The apps used to open this page with the key in the address. Take
  // it, then swap the address for a clean one. replaceState keeps the key
  // out of the bar and out of a reload, but the browser has already
  // written the visit to its global history: that is why the apps now
  // open #renew instead and put the key on the clipboard.
  const params = new URLSearchParams(window.location.search);
  const presetKey = params.get("key");
  if (presetKey && keyInput) {
    keyInput.value = presetKey;
    formatKeyInput(keyInput);
    params.delete("key");
    const query = params.toString();
    history.replaceState(
      null,
      "",
      `${window.location.pathname}${query ? `?${query}` : ""}#renew`,
    );
    document.getElementById("renew")?.scrollIntoView();
    if (renewButton) focusWhenLoaded(renewButton);
  } else if (window.location.hash === "#renew" && keyInput) {
    // Opened straight on the renewal form: the browser scrolls to it,
    // the field is empty, and the key is on the clipboard when the app
    // sent you here.
    if (renewPaste) renewPaste.hidden = false;
    focusWhenLoaded(keyInput);
  }

  // "Add time to a key" at the top of the page lands on the same form.
  window.addEventListener("hashchange", () => {
    if (window.location.hash === "#renew") keyInput?.focus({ preventScroll: true });
  });
</script>
