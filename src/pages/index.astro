---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import AppShell from "../components/AppShell.astro";
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";

// The hero shows a screenshot of the desktop app as soon as one sits at
// src/assets/hero.png (or .webp). Until then, the drawn miniature stands in.
const shots = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/hero.{png,webp}",
  { eager: true },
);
const heroShot = Object.values(shots)[0]?.default;

const features = [
  {
    icon: "wallet",
    title: "Any wallet you already have",
    body: "A descriptor, an xpub, an address, a multisig setup, a BSMS record or another wallet's export.",
  },
  {
    icon: "scan-line",
    title: "Paste, file or QR",
    body: "Paste it, open a file or scan a QR code, static or animated.",
  },
  {
    icon: "layers",
    title: "Several wallets at once",
    body: "Rename them, give them an icon, reorder the list.",
  },
  {
    icon: "history",
    title: "Balances and history",
    body: "Every wallet with its balance, its transactions and the last sync time.",
  },
  {
    icon: "waypoints",
    title: "Transactions as diagrams",
    body: "Inputs on the left, outputs on the right, the fee on its own branch, sized by amount.",
  },
  {
    icon: "boxes",
    title: "UTXO view",
    body: "The exact coins behind a balance, each with its amount and address.",
  },
  {
    icon: "inbox",
    title: "Receive addresses",
    body: "The next addresses with their QR code, the used ones marked.",
  },
  {
    icon: "route",
    title: "Miniscript policies",
    body: "Every spending path of a descriptor, each timelock counted down.",
  },
  {
    icon: "send",
    title: "Broadcast",
    body: "Push a signed transaction or a PSBT, read back in plain words first.",
  },
  {
    icon: "server",
    title: "Your own node",
    body: "Electrum or Esplora, yours or a public one. A self-signed certificate is trusted by its fingerprint.",
  },
  {
    icon: "globe-lock",
    title: "Tor built in",
    body: "An .onion backend works with nothing else to install.",
  },
  {
    icon: "refresh-cw",
    title: "Sync on a schedule",
    body: "Every 5, 15 or 60 minutes while the desktop app is open.",
  },
  {
    icon: "network",
    title: "Four networks",
    body: "Mainnet, signet, testnet4 and regtest.",
  },
  {
    icon: "lock",
    title: "Encrypted storage",
    body: "Wallet data is stored encrypted on the device.",
  },
  {
    icon: "fingerprint",
    title: "App lock",
    body: "A PIN or a password, and biometrics on Android.",
  },
  {
    icon: "file-lock",
    title: "Encrypted backup",
    body: "A password-sealed file, or an animated QR, to sync two devices.",
  },
  {
    icon: "file-spreadsheet",
    title: "CSV export",
    body: "A wallet's history as a CSV file.",
  },
  {
    icon: "coins",
    title: "BTC or sats, with fiat",
    body: "One unit everywhere, and an optional fiat value from CoinGecko, Kraken or mempool.space.",
  },
  {
    icon: "sun-moon",
    title: "Light and dark",
    body: "The Toundra palette in both themes.",
  },
  {
    icon: "layout-grid",
    title: "Widgets and notifications",
    body: "Android home screen widgets, and a local notification when a sync finds something new.",
  },
] as const;

const premium = [
  {
    icon: "shield-alert",
    title: "Coins move, you know",
    body: "An alert when a spend enters the mempool, a second one when it confirms.",
  },
  {
    icon: "radar",
    title: "Daily rescan",
    body: "Once a day the server rescans the UTXO set to catch what the live watch could have missed.",
  },
  {
    icon: "timer",
    title: "Timelock warnings",
    body: "30, 7 and 1 day before a recovery path opens, and again the day it does.",
  },
  {
    icon: "bell",
    title: "Your channels",
    body: "ntfy, Telegram, e-mail, or a webhook signed with HMAC-SHA256.",
  },
  {
    icon: "key-round",
    title: "No account",
    body: "A key you buy once. No name, no password, no sign-up.",
  },
  {
    icon: "bitcoin",
    title: "Paid in bitcoin",
    body: "Ark, Lightning or on-chain, from 5 € a month.",
  },
  {
    icon: "wallet-cards",
    title: "Up to 21 wallets",
    body: "One key watches up to 21 wallets.",
  },
  {
    icon: "trash-2",
    title: "Gone when you say so",
    body: "Remove a wallet from the app and its data leaves the server.",
  },
  {
    icon: "globe-lock",
    title: "Over Tor",
    body: "When your backend is a .onion, the calls to the server go through Tor too.",
  },
] as const;
---

<Base
  title="Gerfaut · Bitcoin watch-only wallet"
  description="Gerfaut is a Bitcoin watch-only wallet for desktop and Android. It observes your wallets from descriptors and public keys, holds no private keys, and cannot spend."
>
  <section class="pt-14 pb-12 md:pt-20">
    <div class="mx-auto max-w-[1200px] px-4 md:px-6">
      <div
        class="grid items-center gap-12 lg:grid-cols-[minmax(0,10fr)_minmax(0,11fr)] lg:gap-16"
      >
        <div>
          <p class="text-label tracking-[0.04em] text-primary uppercase">
            Bitcoin watch-only wallet
          </p>
          <h1
            class="mt-4 font-display text-[2.375rem] leading-[1.08] font-semibold tracking-[-0.02em] text-text sm:text-[3rem] lg:text-hero"
          >
            Watch your bitcoin. Leave your keys offline.
          </h1>
          <p class="mt-5 max-w-xl text-lg text-muted">
            Gerfaut observes your wallets from descriptors and public keys
            alone. It holds no private keys and cannot spend.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="/download" class="btn btn-primary">
              <Icon name="download" size={16} />
              Download Gerfaut
            </a>
            <a href="https://github.com/gerfaut-wallet" class="btn btn-secondary">
              View the source
            </a>
          </div>
          <p class="mt-6 text-sm text-muted">Free and open source, AGPL-3.0</p>
        </div>
        <div class="min-w-0">
          {
            heroShot ? (
              <figure class="card overflow-hidden">
                <Image
                  src={heroShot}
                  alt="The Gerfaut desktop app: a sidebar with the watched wallets next to a wallet view showing the balance and the transaction history"
                  widths={[480, 720, 960, 1280]}
                  sizes="(min-width: 1024px) 620px, calc(100vw - 32px)"
                  loading="eager"
                  class="block h-auto w-full max-w-full"
                />
              </figure>
            ) : (
              <AppShell />
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16" aria-labelledby="features-heading">
    <div class="mx-auto max-w-[1200px] px-4 md:px-6">
      <h2
        id="features-heading"
        class="font-display text-[1.75rem] leading-[1.15] font-semibold tracking-[-0.02em] md:text-display"
      >
        What Gerfaut does
      </h2>
      <ul
        class="mt-10 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5"
      >
        {
          features.map((feature) => (
            <li class="card p-5">
              <span class="flex h-9 w-9 items-center justify-center rounded-md bg-sunken text-primary">
                <Icon name={feature.icon} size={18} />
              </span>
              <h3 class="mt-4 font-display text-[1rem] font-semibold">
                {feature.title}
              </h3>
              <p class="mt-1.5 text-sm text-muted">{feature.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section
    class="dark-island bg-background py-16 text-text md:py-24"
    aria-labelledby="premium-heading"
  >
    <div class="mx-auto max-w-[1200px] px-4 md:px-6">
      <div
        class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between"
      >
        <div class="max-w-2xl">
          <span class="pill-premium">
            <Icon name="gem" size={12} />
            Premium
          </span>
          <h2
            id="premium-heading"
            class="mt-5 font-display text-[1.75rem] leading-[1.15] font-semibold tracking-[-0.02em] md:text-display"
          >
            The apps watch. Premium wakes you up.
          </h2>
          <p class="mt-4 text-muted">
            The apps are free and stay free. Premium adds a server that watches
            your wallets around the clock and tells you when something moves,
            with no account and paid in bitcoin.
          </p>
        </div>
        <a href="/premium" class="btn btn-primary shrink-0">
          Explore Premium
          <Icon name="arrow-up-right" size={16} />
        </a>
      </div>
      <ul
        class="mt-12 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5"
      >
        {
          premium.map((item) => (
            <li class="card p-5 sm:last:col-span-2 lg:last:col-span-1">
              <span class="flex h-9 w-9 items-center justify-center rounded-md bg-sunken text-primary">
                <Icon name={item.icon} size={18} />
              </span>
              <h3 class="mt-4 font-display text-[1rem] font-semibold">
                {item.title}
              </h3>
              <p class="mt-1.5 text-sm text-muted">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-16 md:py-24" aria-labelledby="platforms-heading">
    <div class="mx-auto max-w-[1200px] px-4 md:px-6">
      <h2
        id="platforms-heading"
        class="font-display text-[1.75rem] leading-[1.15] font-semibold tracking-[-0.02em] md:text-display"
      >
        Runs where you are
      </h2>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:gap-5">
        <div class="card flex items-start gap-4 p-6">
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-sunken text-primary"
          >
            <Icon name="monitor" />
          </span>
          <div>
            <h3 class="text-h2 font-display">Desktop</h3>
            <p class="mt-1.5 text-sm text-muted">
              Windows, macOS, and Linux. A light native app built with Tauri,
              with keyboard-first navigation.
            </p>
          </div>
        </div>
        <div class="card flex items-start gap-4 p-6">
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-sunken text-primary"
          >
            <Icon name="smartphone" />
          </span>
          <div>
            <h3 class="text-h2 font-display">Android</h3>
            <p class="mt-1.5 text-sm text-muted">
              A Flutter app, distributed as a direct APK. iOS is planned for a
              later stage.
            </p>
          </div>
        </div>
      </div>
      <p class="mt-8">
        <a
          href="/download"
          class="inline-flex min-h-11 cursor-pointer items-center gap-1.5 text-sm font-medium text-primary transition-colors duration-150 hover:text-primary-hover"
        >
          Go to downloads
          <Icon name="arrow-up-right" size={16} />
        </a>
      </p>
    </div>
  </section>
</Base>
