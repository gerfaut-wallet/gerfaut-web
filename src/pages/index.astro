---
import AppShell from "../components/AppShell.astro";
import FlowDiagram from "../components/FlowDiagram.astro";
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";

const features = [
  {
    icon: "qr-code",
    title: "Add wallets your way",
    body: "Paste a descriptor or an xpub, scan a QR code, or import a wallet export file. Gerfaut confirms what it recognized before adding anything.",
  },
  {
    icon: "history",
    title: "Balances and history",
    body: "Each wallet shows its balance and full transaction history, with the last sync time always in view.",
  },
  {
    icon: "waypoints",
    title: "Transactions as diagrams",
    body: "Every transaction opens as a flow: inputs on the left, outputs on the right, fee on its own branch, weighted by amount.",
  },
  {
    icon: "boxes",
    title: "UTXO view",
    body: "See the exact coins behind a balance, with the amount and address of each output.",
  },
  {
    icon: "shield-check",
    title: "Careful receive flow",
    body: "Receive addresses come with a standing warning: verify the address on your signing device before sharing it.",
  },
  {
    icon: "server",
    title: "Electrum and Esplora",
    body: "Use a public server or point Gerfaut at your own node. Tor onion endpoints are supported.",
  },
  {
    icon: "coins",
    title: "BTC or sats, with fiat",
    body: "One unit setting, applied everywhere. Optional fiat values from CoinGecko, Kraken, or mempool.space.",
  },
  {
    icon: "sun-moon",
    title: "Light and dark",
    body: "The Toundra palette in both themes, built to keep numbers readable first.",
  },
] as const;
---

<Base
  title="Gerfaut · Bitcoin watch-only wallet"
  description="Gerfaut is a Bitcoin watch-only wallet for desktop and Android. It observes your wallets from descriptors and public keys, holds no private keys, and cannot spend."
>
  <section class="pt-14 pb-12 md:pt-20">
    <div class="mx-auto max-w-[1200px] px-4 md:px-6">
      <div
        class="grid items-center gap-12 lg:grid-cols-[minmax(0,10fr)_minmax(0,11fr)] lg:gap-16"
      >
        <div>
          <p class="text-label tracking-[0.04em] text-primary uppercase">
            Bitcoin watch-only wallet
          </p>
          <h1
            class="mt-4 font-display text-[2.375rem] leading-[1.08] font-semibold tracking-[-0.02em] text-text sm:text-[3rem] lg:text-hero"
          >
            Watch your bitcoin. Leave your keys offline.
          </h1>
          <p class="mt-5 max-w-xl text-lg text-muted">
            Gerfaut observes your wallets from descriptors and public keys
            alone. It holds no private key, signs nothing, and cannot spend.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="/download" class="btn btn-primary">
              <Icon name="download" size={16} />
              Download Gerfaut
            </a>
            <a href="https://github.com/gerfaut-wallet" class="btn btn-secondary">
              View the source
            </a>
          </div>
          <p class="mt-6 text-sm text-muted">
            Free and open source, AGPL-3.0 &middot; No account &middot; No
            telemetry
          </p>
        </div>
        <AppShell />
      </div>
    </div>
  </section>

  <section class="py-12" aria-labelledby="watch-only-heading">
    <div class="mx-auto max-w-[1200px] px-4 md:px-6">
      <h2
        id="watch-only-heading"
        class="font-display text-[1.75rem] leading-[1.15] font-semibold tracking-[-0.02em] md:text-display"
      >
        Watch-only by design
      </h2>
      <div class="mt-10 grid gap-10 md:grid-cols-3 md:gap-8">
        <div>
          <span
            class="flex h-10 w-10 items-center justify-center rounded-md bg-sunken text-primary"
          >
            <Icon name="lock" />
          </span>
          <h3 class="mt-4 text-h2 font-display">No keys, ever</h3>
          <p class="mt-2 text-sm text-muted">
            There is no key generation, no seed storage, and no signing code
            anywhere in Gerfaut. An app that never touches keys cannot leak
            them.
          </p>
        </div>
        <div>
          <span
            class="flex h-10 w-10 items-center justify-center rounded-md bg-sunken text-primary"
          >
            <Icon name="server" />
          </span>
          <h3 class="mt-4 text-h2 font-display">Your node, your rules</h3>
          <p class="mt-2 text-sm text-muted">
            Start on the default public servers, then connect your own Electrum
            or Esplora instance when you want to, including over Tor.
          </p>
        </div>
        <div>
          <span
            class="flex h-10 w-10 items-center justify-center rounded-md bg-sunken text-primary"
          >
            <Icon name="eye" />
          </span>
          <h3 class="mt-4 text-h2 font-display">Nothing to sign up for</h3>
          <p class="mt-2 text-sm text-muted">
            There is no account to create and no telemetry to opt out of. Your
            descriptors stay on your device.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12" aria-labelledby="features-heading">
    <div class="mx-auto max-w-[1200px] px-4 md:px-6">
      <h2
        id="features-heading"
        class="font-display text-[1.75rem] leading-[1.15] font-semibold tracking-[-0.02em] md:text-display"
      >
        What Gerfaut does
      </h2>
      <p class="mt-3 max-w-xl text-muted">
        Everything below ships in the apps today. Nothing here is a roadmap
        promise.
      </p>
      <div
        class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5"
      >
        {
          features.map((feature) => (
            <div class="card p-5">
              <span class="flex h-9 w-9 items-center justify-center rounded-md bg-sunken text-primary">
                <Icon name={feature.icon} size={18} />
              </span>
              <h3 class="mt-4 font-display text-[1rem] font-semibold">
                {feature.title}
              </h3>
              <p class="mt-1.5 text-sm text-muted">{feature.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-12" aria-labelledby="flow-heading">
    <div class="mx-auto max-w-[1200px] px-4 md:px-6">
      <div
        class="grid items-center gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16"
      >
        <div>
          <h2
            id="flow-heading"
            class="font-display text-[1.75rem] leading-[1.15] font-semibold tracking-[-0.02em] md:text-display"
          >
            Read a transaction at a glance
          </h2>
          <p class="mt-4 text-muted">
            A transaction usually reads as a wall of hex. Gerfaut draws it
            instead: your inputs and outputs in the accent color, external
            ones in neutral, the network fee on its own branch. Curve
            thickness follows the amounts, so you see the shape of a payment
            before reading a single number.
          </p>
        </div>
        <FlowDiagram />
      </div>
    </div>
  </section>

  <section class="pt-12 pb-16 md:pb-24" aria-labelledby="platforms-heading">
    <div class="mx-auto max-w-[1200px] px-4 md:px-6">
      <h2
        id="platforms-heading"
        class="font-display text-[1.75rem] leading-[1.15] font-semibold tracking-[-0.02em] md:text-display"
      >
        Runs where you are
      </h2>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:gap-5">
        <div class="card flex items-start gap-4 p-6">
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-sunken text-primary"
          >
            <Icon name="monitor" />
          </span>
          <div>
            <h3 class="text-h2 font-display">Desktop</h3>
            <p class="mt-1.5 text-sm text-muted">
              Windows, macOS, and Linux. A light native app built with Tauri,
              with keyboard-first navigation.
            </p>
          </div>
        </div>
        <div class="card flex items-start gap-4 p-6">
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-sunken text-primary"
          >
            <Icon name="smartphone" />
          </span>
          <div>
            <h3 class="text-h2 font-display">Android</h3>
            <p class="mt-1.5 text-sm text-muted">
              A Flutter app, distributed as a direct APK. iOS is planned for a
              later stage.
            </p>
          </div>
        </div>
      </div>
      <p class="mt-8">
        <a
          href="/download"
          class="inline-flex cursor-pointer items-center gap-1.5 text-sm font-medium text-primary transition-colors duration-150 hover:text-primary-hover"
        >
          Go to downloads
          <Icon name="arrow-up-right" size={16} />
        </a>
      </p>
    </div>
  </section>

  <section
    class="dark-island bg-background py-16 text-text md:py-24"
    aria-labelledby="premium-heading"
  >
    <div class="mx-auto max-w-[1200px] px-4 md:px-6">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="text-label tracking-[0.04em] text-primary uppercase">
            Gerfaut Premium
          </p>
          <h2
            id="premium-heading"
            class="mt-4 font-display text-[1.75rem] leading-[1.15] font-semibold tracking-[-0.02em] md:text-display"
          >
            The apps watch. Premium wakes you up.
          </h2>
          <p class="mt-4 text-muted">
            The apps are free and stay free. Premium adds a server that
            watches the chain around the clock and tells you when something
            moves, without an account and paid in bitcoin.
          </p>
          <a href="/premium" class="btn btn-primary mt-8">
            Explore Premium
          </a>
        </div>
        <ul class="space-y-6">
          <li class="flex items-start gap-4">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-surface text-primary"
            >
              <Icon name="shield-alert" />
            </span>
            <div>
              <h3 class="text-h2 font-display">Theft alert</h3>
              <p class="mt-1 text-sm text-muted">
                A notification within seconds when a coin moves without you.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-surface text-primary"
            >
              <Icon name="timer" />
            </span>
            <div>
              <h3 class="text-h2 font-display">Timelock watch</h3>
              <p class="mt-1 text-sm text-muted">
                A warning before a recovery path becomes spendable.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-surface text-primary"
            >
              <Icon name="bell" />
            </span>
            <div>
              <h3 class="text-h2 font-display">Your channels</h3>
              <p class="mt-1 text-sm text-muted">
                ntfy, Telegram, e-mail or a signed webhook. You pick what reaches
                you.
              </p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>
