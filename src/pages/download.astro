---
import CodeBlock from "../components/CodeBlock.astro";
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";

// Listed in this order whenever the list is written out by hand: Linux,
// Windows, macOS, Android. The visitor's own system is only marked.
const platforms = [
  {
    slot: "linux",
    name: "Linux",
    icon: "monitor",
    formats: ".AppImage, .deb and .rpm packages",
    repo: "gerfaut-desktop",
  },
  {
    slot: "windows",
    name: "Windows",
    icon: "monitor",
    formats: ".exe installer",
    repo: "gerfaut-desktop",
  },
  {
    slot: "macos",
    name: "macOS",
    icon: "monitor",
    formats: ".app in a .zip archive",
    repo: "gerfaut-desktop",
  },
  {
    slot: "android",
    name: "Android",
    icon: "smartphone",
    formats: "one .apk per processor",
    repo: "gerfaut-mobile",
  },
] as const;

const minisignKey = "RWTz3c4gUmglCX5Uvjthigz1ts3TS3ZSdhRNpFgOJRW/Wr4XjGlqTR3O";
---

<Base
  title="Download Gerfaut · Bitcoin watch-only wallet"
  description="Download Gerfaut for Linux, Windows, macOS and Android. Free and open source, with checksums signed by the author's minisign key."
>
  <section class="pt-16 pb-12 md:pt-24">
    <div class="site-container">
      <div class="mx-auto max-w-2xl text-center">
        <h1
          class="font-display text-[2.25rem] leading-[1.05] font-semibold tracking-[-0.03em] sm:text-[2.75rem] lg:text-hero"
        >
          Download Gerfaut
        </h1>
        <p class="mt-5 text-lg text-muted">
          Free and open source. Every release ships with checksums signed by
          the author's minisign key.
        </p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:gap-5">
        {
          platforms.map((platform) => (
            <div
              id={platform.slot}
              class="card flex min-w-0 scroll-mt-24 flex-col p-6"
              data-platform={platform.slot}
            >
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-sunken text-primary">
                  <Icon name={platform.icon} />
                </span>
                <div class="min-w-0 flex-1">
                  <h2 class="text-h2 font-display">{platform.name}</h2>
                  <p class="text-sm text-muted">{platform.formats}</p>
                </div>
                <span class="pill pill-neutral hidden" data-platform-current>
                  Your system
                </span>
                <span
                  class="font-data hidden rounded-sm bg-sunken px-2 py-1 text-data text-muted"
                  data-release-version={platform.slot}
                />
              </div>
              <div
                class="mt-5 border-t border-border pt-4"
                data-release={platform.slot}
                aria-live="polite"
              >
                <div data-state="loading" hidden>
                  <p class="text-sm text-muted">
                    Checking the latest release&hellip;
                  </p>
                </div>
                <div data-state="empty" hidden>
                  <p class="text-sm font-medium">
                    The first public release is coming.
                  </p>
                  <p class="mt-1 text-sm text-muted">
                    Builds appear here the moment the first release is tagged.
                    Until then, follow the project on
                    <a href="https://github.com/gerfaut-wallet" class="link">
                      GitHub</a
                    >.
                  </p>
                </div>
                <div data-state="missing" hidden>
                  <p class="text-sm font-medium">
                    <span data-missing-version>This release</span> has no
                    {platform.name} build.
                  </p>
                  <p class="mt-1 text-sm text-muted">
                    Its notes and the earlier builds are on the
                    <a
                      href={`https://github.com/gerfaut-wallet/${platform.repo}/releases`}
                      class="link">releases page</a
                    >.
                  </p>
                </div>
                <div data-state="elsewhere">
                  <p class="text-sm font-medium">The files are on GitHub.</p>
                  <p class="mt-1 text-sm text-muted">
                    This page could not read the latest release. Every file is
                    on the
                    <a
                      href={`https://github.com/gerfaut-wallet/${platform.repo}/releases/latest`}
                      class="link">release page</a
                    >.
                  </p>
                </div>
                <ul data-state="list" hidden class="space-y-2" />
              </div>
            </div>
          ))
        }
      </div>

      <p class="mt-8 text-center text-sm text-muted">
        All builds and release notes live on
        <a href="https://github.com/gerfaut-wallet" class="link"
          >github.com/gerfaut-wallet</a
        >.
      </p>
    </div>
  </section>

  <section
    id="verify"
    class="section scroll-mt-20"
    aria-labelledby="verify-heading"
  >
    <div class="site-container">
      <div class="card mx-auto max-w-3xl p-6 md:p-8">
        <div class="flex items-center gap-3">
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-sunken text-primary"
          >
            <Icon name="shield-check" />
          </span>
          <h2 id="verify-heading" class="text-h1 font-display">
            Verify your download
          </h2>
        </div>
        <p class="mt-4 text-sm text-muted">
          Two commands prove that the files were signed by the author and
          arrived unchanged. Shown here for Linux: the
          <span class="font-data">SHA256SUMS</span> file and its signature sit
          next to the builds on the release page,
          <a
            href="https://github.com/gerfaut-wallet/gerfaut-desktop/releases/latest"
            class="link">desktop</a
          >
          or
          <a
            href="https://github.com/gerfaut-wallet/gerfaut-mobile/releases/latest"
            class="link">Android</a
          >, and go in the folder of the file you are checking.
        </p>
        <h3 class="mt-6 text-sm font-medium">
          1. Check the signature of the checksum file
        </h3>
        <CodeBlock
          text={`minisign -Vm SHA256SUMS -P ${minisignKey}`}
          label="the minisign command"
        />
        <h3 class="mt-5 text-sm font-medium">2. Check the file you downloaded</h3>
        <CodeBlock
          text="sha256sum --check SHA256SUMS --ignore-missing"
          label="the sha256sum command"
        />
        <h3 class="mt-6 text-sm font-medium">Author's minisign public key</h3>
        <CodeBlock text={minisignKey} label="the minisign public key" />
        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-border pt-5">
          <a
            href="https://gerfaut-wallet.com/docs/getting-started/verify-your-download"
            class="btn btn-primary"
          >
            Every system, step by step
            <Icon name="arrow-up-right" size={16} />
          </a>
          <p class="text-sm text-muted">
            Linux, Windows, macOS and Android, in the documentation.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { detectPlatform } from "../lib/platform";

  type Asset = { name: string; browser_download_url: string; size: number };
  type Release = { tag_name: string; assets: Asset[] };

  // A slot lists every asset its pattern matches. `variants` puts them in
  // order and says what each one is for, since a name like
  // Gerfaut-0.1.0-1.x86_64.rpm or armeabi-v7a answers nobody's question.
  // With `fold`, the first variant is the one almost everyone wants and
  // the rest fold away: Android ships one build per processor.
  //
  // The files of a release, as the recipes under reproducible/ in
  // gerfaut-desktop name them: Gerfaut_<version>_amd64.AppImage,
  // Gerfaut_<version>_amd64.deb, Gerfaut-<version>-1.x86_64.rpm,
  // Gerfaut_<version>_x64-setup.exe and Gerfaut_<version>_universal.zip,
  // which holds Gerfaut.app. Android: one .apk per processor.
  type Variant = { pattern: RegExp; note: string };
  type Matcher = {
    repo: string;
    pattern: RegExp;
    variants?: Variant[];
    fold?: boolean;
  };

  const matchers: Record<string, Matcher> = {
    linux: {
      repo: "gerfaut-desktop",
      pattern: /\.(appimage|deb|rpm)$/i,
      variants: [
        { pattern: /\.appimage$/i, note: "Any distribution: make it executable, then run it" },
        { pattern: /\.deb$/i, note: "Debian, Ubuntu and their derivatives" },
        { pattern: /\.rpm$/i, note: "Fedora and other RPM-based systems" },
      ],
    },
    windows: {
      repo: "gerfaut-desktop",
      pattern: /\.exe$/i,
      variants: [{ pattern: /\.exe$/i, note: "Installer for 64-bit Windows" }],
    },
    macos: {
      repo: "gerfaut-desktop",
      pattern: /\.zip$/i,
      variants: [
        {
          pattern: /\.zip$/i,
          note: "Apple Silicon and Intel: unzip it, then move Gerfaut to Applications",
        },
      ],
    },
    android: {
      repo: "gerfaut-mobile",
      pattern: /\.apk$/i,
      fold: true,
      variants: [
        { pattern: /arm64-v8a/i, note: "Almost every phone sold since 2017" },
        { pattern: /armeabi-v7a/i, note: "Older 32-bit phones" },
        { pattern: /x86_64/i, note: "Emulators and x86 tablets" },
      ],
    },
  };

  function setState(slot: Element, state: string) {
    for (const panel of slot.querySelectorAll<HTMLElement>("[data-state]")) {
      panel.hidden = panel.dataset.state !== state;
    }
  }

  function formatSize(bytes: number): string {
    const mb = bytes / (1024 * 1024);
    return mb >= 100 ? `${Math.round(mb)} MB` : `${mb.toFixed(1)} MB`;
  }

  // What GitHub said about the latest release: the release itself,
  // "none" when there is no release yet (a 404), or "error" when the
  // answer never came or made no sense: offline, rate limited, down.
  type Latest = Release | "none" | "error";

  async function latest(repo: string): Promise<Latest> {
    try {
      const res = await fetch(
        `https://api.github.com/repos/gerfaut-wallet/${repo}/releases/latest`,
        { headers: { Accept: "application/vnd.github+json" } },
      );
      if (res.status === 404) return "none";
      if (!res.ok) return "error";
      const release = (await res.json()) as Release;
      return Array.isArray(release.assets) ? release : "error";
    } catch {
      return "error";
    }
  }

  // One downloadable file: its name, what it is for, and its weight.
  function row(asset: Asset, note?: string): HTMLLIElement {
    const item = document.createElement("li");
    const link = document.createElement("a");
    link.href = asset.browser_download_url;
    link.className =
      "flex min-h-11 cursor-pointer items-center justify-between gap-3 rounded-md bg-sunken px-3 py-2.5 transition-colors duration-150 hover:bg-border/60";
    const text = document.createElement("span");
    text.className = "min-w-0 flex-1";
    const label = document.createElement("span");
    label.className = "font-data block truncate text-data";
    label.textContent = asset.name;
    text.append(label);
    if (note) {
      const hint = document.createElement("span");
      hint.className = "mt-0.5 block text-sm text-muted";
      hint.textContent = note;
      text.append(hint);
    }
    const size = document.createElement("span");
    size.className = "shrink-0 text-sm text-muted";
    size.textContent = formatSize(asset.size);
    link.append(text, size);
    item.append(link);
    return item;
  }

  // Orders the assets the way the variants are declared, unmatched last,
  // and carries each one's note along.
  function ordered(
    assets: Asset[],
    variants?: Variant[],
  ): { asset: Asset; note?: string }[] {
    if (!variants) return assets.map((asset) => ({ asset }));
    const rank = (asset: Asset) => {
      const index = variants.findIndex((v) => v.pattern.test(asset.name));
      return index === -1 ? variants.length : index;
    };
    return [...assets]
      .sort((a, b) => rank(a) - rank(b))
      .map((asset) => ({ asset, note: variants[rank(asset)]?.note }));
  }

  // Every state but the list ends on a link to GitHub: no release yet,
  // a release without a file for this system, or no answer at all.
  function render(name: string, release: Latest) {
    const slot = document.querySelector(`[data-release="${name}"]`);
    if (!slot) return;
    if (release === "none" || release === "error") {
      setState(slot, release === "none" ? "empty" : "elsewhere");
      return;
    }
    const assets = release.assets.filter((asset) =>
      matchers[name]?.pattern.test(asset.name),
    );
    if (assets.length === 0) {
      const named = slot.querySelector<HTMLElement>("[data-missing-version]");
      if (named) named.textContent = release.tag_name;
      setState(slot, "missing");
      return;
    }
    const version = document.querySelector<HTMLElement>(
      `[data-release-version="${name}"]`,
    );
    if (version) {
      version.textContent = release.tag_name;
      version.hidden = false;
      version.classList.remove("hidden");
    }
    const list = slot.querySelector<HTMLElement>('[data-state="list"]');
    if (!list) return;
    list.textContent = "";
    const variants = matchers[name]?.variants;
    const fold = matchers[name]?.fold ?? false;
    const entries = ordered(assets, variants);
    // Files for different systems all stay in view. Files for different
    // processors fold: only the first is offered outright, since three
    // processor names side by side turn a download into a quiz.
    const shown = fold ? entries.slice(0, 1) : entries;
    const folded = fold ? entries.slice(1) : [];
    for (const { asset, note } of shown) list.append(row(asset, note));
    if (folded.length > 0) {
      const details = document.createElement("details");
      details.className = "mt-2";
      const summary = document.createElement("summary");
      summary.className =
        "flex min-h-11 cursor-pointer items-center rounded-md px-1 text-sm text-muted transition-colors duration-150 hover:text-text";
      summary.textContent = `Other architectures (${folded.length})`;
      const inner = document.createElement("ul");
      inner.className = "mt-2 space-y-2";
      for (const { asset, note } of folded) inner.append(row(asset, note));
      details.append(summary, inner);
      const item = document.createElement("li");
      item.append(details);
      list.append(item);
    }
    setState(slot, "list");
  }

  async function load() {
    for (const slot of document.querySelectorAll("[data-release]")) {
      setState(slot, "loading");
    }
    const [desktop, mobile] = await Promise.all([
      latest("gerfaut-desktop"),
      latest("gerfaut-mobile"),
    ]);
    render("linux", desktop);
    render("windows", desktop);
    render("macos", desktop);
    render("android", mobile);
  }

  // The card of the visitor's system stands out: a Glacier border and a
  // pill. The address names a platform when the home page sent the
  // visitor here; otherwise the system is read from the browser.
  function highlight(slot: string) {
    const card = document.querySelector<HTMLElement>(`[data-platform="${slot}"]`);
    if (!card) return;
    card.classList.add("card-current");
    card.querySelector<HTMLElement>("[data-platform-current]")?.classList.remove("hidden");
  }
  const named = window.location.hash.slice(1);
  if (named in matchers) highlight(named);
  else {
    const detected = detectPlatform();
    if (detected) highlight(detected.slot);
  }

  load();

  // The copy buttons of the verify section: the clipboard when the page
  // is allowed to write it, a short check as the only feedback.
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
      } catch {
        return;
      }
      button.setAttribute("data-done", "");
      setTimeout(() => button.removeAttribute("data-done"), 1500);
    });
  }
</script>
