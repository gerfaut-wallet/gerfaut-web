---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found · Gerfaut"
  noindex
  description="This page does not exist."
>
  <section class="py-24 md:py-32">
    <div class="site-container">
      <p class="font-data text-data text-muted">404</p>
      <h1
        class="mt-3 font-display text-[2rem] leading-[1.1] font-semibold tracking-[-0.02em]"
      >
        Page not found
      </h1>
      <p class="mt-4 max-w-md text-muted">
        This address does not exist. Check the URL, or start again from the
        home page.
      </p>
      <a href="/" class="btn btn-primary mt-8">Back to the home page</a>
    </div>
  </section>
</Base>
