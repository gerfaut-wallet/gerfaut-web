---
import Icon from "../../components/Icon.astro";
import Base from "../../layouts/Base.astro";

// The page Bark Pay sends the buyer back to, with the payment reference
// in `?ref=`. It asks the API every 3 seconds where the charge stands
// and stops on its own after 10 minutes.

const linkClass =
  "link";
---

<Base
  title="Your payment · Gerfaut Premium"
  noindex
  description="The return page after a Gerfaut Premium payment: it checks the charge and tells you when your key is active."
>
  <section class="py-16 md:py-24">
    <div class="site-container">
      <div class="max-w-2xl">
        <span class="pill-premium">
          <Icon name="gem" size={12} />
          Premium
        </span>

        <div id="paid-states" class="mt-5" aria-live="polite">
          <div data-state="checking">
            <h1
              class="font-display text-[2rem] leading-[1.1] font-semibold tracking-[-0.02em]"
            >
              Checking your payment&hellip;
            </h1>
            <p class="mt-4 text-muted">
              One moment: the page is asking the server where the charge
              stands.
            </p>
          </div>

          <div data-state="pending" hidden>
            <h1
              class="font-display text-[2rem] leading-[1.1] font-semibold tracking-[-0.02em]"
            >
              Waiting for your payment
            </h1>
            <p class="mt-4 flex flex-wrap items-center gap-2 text-muted">
              <span class="pill pill-pending">
                <Icon name="clock" size={12} />
                <span data-status-label>Pending</span>
              </span>
              <span>
                Checked every 3 seconds. Last check at
                <span data-last-checked class="tabular-nums">&hellip;</span>
              </span>
            </p>
            <p class="mt-4 text-muted">
              Lightning and Ark payments usually show up within a few seconds
              of sending. An on-chain payment needs a confirmation, so it can
              take ten minutes or more. Your time is credited the moment the
              payment confirms, whether this page is open or not.
            </p>
            <p class="mt-4 text-sm text-muted">
              Not paid yet? Use your browser's back button to return to the
              checkout page.
            </p>
          </div>

          <div data-state="underpaid" hidden>
            <h1
              class="font-display text-[2rem] leading-[1.1] font-semibold tracking-[-0.02em]"
            >
              The payment came in short
            </h1>
            <p class="mt-4 flex flex-wrap items-center gap-2 text-muted">
              <span class="pill pill-pending">
                <Icon name="clock" size={12} />
                Underpaid
              </span>
              <span>
                Checked every 3 seconds. Last check at
                <span data-last-checked class="tabular-nums">&hellip;</span>
              </span>
            </p>
            <p class="mt-4 text-muted">
              The checkout page shows the amount still missing. Send the rest
              from the same page: the time is credited as soon as it arrives,
              and this page updates on its own. Use your browser's back button
              to get back to the checkout.
            </p>
          </div>

          <div data-state="paid" hidden>
            <h1
              class="font-display text-[2rem] leading-[1.1] font-semibold tracking-[-0.02em]"
            >
              Paid. Your Premium key is active until
              <span data-paid-until class="tabular-nums whitespace-nowrap"
              ></span>.
            </h1>
            <p class="mt-4 text-muted">
              Thank you. The time is on your key; the next step happens in the
              app.
            </p>
            <div class="card mt-8 p-5 sm:p-6">
              <h2 class="text-h2 font-display">Activate Premium in Gerfaut</h2>
              <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm">
                <li>Open Gerfaut on the device you use.</li>
                <li>Go to Settings, then Premium.</li>
                <li>Enter your Premium key and press Activate.</li>
              </ol>
              <p class="mt-4 text-sm text-muted">
                Then switch on the wallets you want watched and add a channel.
                Gerfaut sends a test message when you add your first one.
              </p>
            </div>
            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a href="/download" class="btn btn-primary">
                <Icon name="download" size={16} />
                Download Gerfaut
              </a>
              <a href="/premium" class={linkClass + " text-sm"}>Back to Premium</a>
            </div>
          </div>

          <div data-state="closed" hidden>
            <h1
              class="font-display text-[2rem] leading-[1.1] font-semibold tracking-[-0.02em]"
            >
              This checkout is closed
            </h1>
            <p class="mt-4 text-muted">
              It expired or was cancelled, and nothing was charged. A key you
              already had is unchanged. Start again from the Premium page: to
              add time to an existing key, use "Add time" with that key.
            </p>
            <a href="/premium" class="btn btn-primary mt-8">
              <Icon name="arrow-left" size={16} />
              Back to Premium
            </a>
          </div>

          <div data-state="timeout" hidden>
            <h1
              class="font-display text-[2rem] leading-[1.1] font-semibold tracking-[-0.02em]"
            >
              Still waiting
            </h1>
            <p class="mt-4 text-muted">
              The page stopped checking after 10 minutes. Your time is
              credited the moment the payment confirms, whether this page is
              open or not. Check again now, or come back later.
            </p>
            <button type="button" data-reload class="btn btn-primary mt-8">
              <Icon name="refresh-cw" size={16} />
              Check again
            </button>
          </div>

          <div data-state="unknown" hidden>
            <h1
              class="font-display text-[2rem] leading-[1.1] font-semibold tracking-[-0.02em]"
            >
              Unknown payment reference
            </h1>
            <p class="mt-4 text-muted">
              The server does not know this reference. Check the address you
              opened. If you did pay, write to
              <a href="mailto:info@pandul.fr" class={linkClass}>info@pandul.fr</a>
              with your Premium key and we will look.
            </p>
            <a href="/premium" class="btn btn-primary mt-8">
              <Icon name="arrow-left" size={16} />
              Back to Premium
            </a>
          </div>

          <div data-state="missing" hidden>
            <h1
              class="font-display text-[2rem] leading-[1.1] font-semibold tracking-[-0.02em]"
            >
              No payment reference
            </h1>
            <p class="mt-4 text-muted">
              This page expects the reference the checkout adds to the
              address when it sends you back. If you just paid, use your
              browser's back button to return to the checkout page. If the
              payment went through and you cannot find your way back, write to
              <a href="mailto:info@pandul.fr" class={linkClass}>info@pandul.fr</a>
              with your Premium key.
            </p>
            <a href="/premium" class="btn btn-primary mt-8">
              <Icon name="arrow-left" size={16} />
              Back to Premium
            </a>
          </div>
        </div>

        <div id="paid-note" class="note note-pending mt-6" hidden>
          <Icon name="info" size={16} />
          <p></p>
        </div>

        <p id="paid-ref" class="mt-10 text-sm text-muted" hidden>
          Payment reference
          <span
            data-ref
            class="font-data ml-1 rounded-sm bg-sunken px-2 py-1 text-data break-all"
          ></span>
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  const API = "https://api.gerfaut-wallet.com";
  const EVERY = 3000;
  const LIMIT = 10 * 60 * 1000;
  const MONTHS = [
    "Jan", "Feb", "Mar", "Apr", "May", "Jun",
    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
  ];

  type Status = {
    charge_id: string;
    status: string;
    plan: string;
    paid_at: number | null;
    paid_until: number | null;
  };

  // One language, one format: "Sep 5, 2027", in the reader's time zone.
  function formatDate(unix: number): string {
    const date = new Date(unix * 1000);
    return `${MONTHS[date.getMonth()]} ${date.getDate()}, ${date.getFullYear()}`;
  }

  function formatTime(date: Date): string {
    const two = (n: number) => String(n).padStart(2, "0");
    return `${two(date.getHours())}:${two(date.getMinutes())}:${two(date.getSeconds())}`;
  }

  const region = document.getElementById("paid-states");
  const noteBox = document.getElementById("paid-note");
  const refLine = document.getElementById("paid-ref");

  function setState(state: string) {
    if (!region) return;
    for (const panel of region.querySelectorAll<HTMLElement>(":scope > [data-state]")) {
      panel.hidden = panel.dataset.state !== state;
    }
  }

  function note(text: string | null) {
    if (!noteBox) return;
    const p = noteBox.querySelector("p");
    if (p && text) p.textContent = text;
    noteBox.hidden = !text;
  }

  function fill(selector: string, text: string) {
    for (const el of document.querySelectorAll<HTMLElement>(selector)) {
      el.textContent = text;
    }
  }

  const ref = new URLSearchParams(window.location.search).get("ref") ?? "";
  const started = Date.now();
  let timer: ReturnType<typeof setTimeout> | undefined;
  let done = false;

  function schedule() {
    clearTimeout(timer);
    timer = setTimeout(poll, EVERY);
  }

  async function poll() {
    if (done) return;
    if (Date.now() - started > LIMIT) {
      done = true;
      note(null);
      setState("timeout");
      return;
    }
    // A hidden tab does not ask; it asks again the moment it is shown.
    if (document.hidden) return;

    let res: Response;
    try {
      res = await fetch(`${API}/v1/checkout/${encodeURIComponent(ref)}`, {
        headers: { Accept: "application/json" },
      });
    } catch {
      note("Could not reach the Gerfaut server. Trying again…");
      schedule();
      return;
    }
    if (res.status === 404) {
      done = true;
      note(null);
      setState("unknown");
      return;
    }
    const data = res.ok
      ? ((await res.json().catch(() => null)) as Status | null)
      : null;
    if (!data || typeof data.status !== "string") {
      note("The server answered with an error. Trying again…");
      schedule();
      return;
    }
    note(null);
    fill("[data-last-checked]", formatTime(new Date()));
    switch (data.status) {
      case "paid":
        done = true;
        fill(
          "[data-paid-until]",
          data.paid_until ? formatDate(data.paid_until) : "the end of your plan",
        );
        setState("paid");
        return;
      case "underpaid":
        setState("underpaid");
        schedule();
        return;
      case "expired":
      case "cancelled":
        done = true;
        setState("closed");
        return;
      default:
        fill(
          "[data-status-label]",
          data.status.charAt(0).toUpperCase() + data.status.slice(1),
        );
        setState("pending");
        schedule();
    }
  }

  document.addEventListener("visibilitychange", () => {
    if (!document.hidden && !done) {
      clearTimeout(timer);
      poll();
    }
  });

  document.querySelector("[data-reload]")?.addEventListener("click", () => {
    window.location.reload();
  });

  if (/^[A-Za-z0-9_-]{1,128}$/.test(ref)) {
    fill("[data-ref]", ref);
    if (refLine) refLine.hidden = false;
    poll();
  } else {
    setState("missing");
  }
</script>
