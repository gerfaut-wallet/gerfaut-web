---
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";

/** A faithful miniature of the desktop app, drawn with the real tokens:
    dark rail island on the left, light canvas on the right. Decorative. */
const transactions = [
  {
    direction: "in",
    label: "Received",
    date: "Aug 12",
    amount: "+0.04500000",
    status: "confirmed",
  },
  {
    direction: "in",
    label: "Received",
    date: "Jul 30",
    amount: "+0.21000000",
    status: "confirmed",
  },
  {
    direction: "out",
    label: "Sent",
    date: "Jul 18",
    amount: "-0.01250000",
    status: "confirmed",
  },
  {
    direction: "in",
    label: "Received",
    date: "Jun 02",
    amount: "+0.00035000",
    status: "pending",
  },
] as const;
---

<figure
  role="img"
  aria-label="The Gerfaut desktop app: a sidebar with watched wallets next to a wallet view showing the balance and the transaction history"
  class="light-island card overflow-hidden font-ui text-text select-none"
>
  <div class="flex">
    <div
      class="dark-island hidden w-44 shrink-0 flex-col justify-between bg-background p-3 text-text sm:flex"
    >
      <div>
        <span class="flex items-center gap-2 px-2 pt-1 pb-4 text-primary">
          <Mark class="h-3.5 w-auto" />
          <span
            class="font-display text-[11px] font-extrabold tracking-[0.08em] uppercase"
            >Gerfaut</span
          >
        </span>
        <span
          class="block px-2 pb-1.5 text-[10px] font-medium tracking-[0.04em] text-muted uppercase"
          >Wallets</span
        >
        <span
          class="flex items-center justify-between rounded-md bg-sunken px-2 py-1.5 text-[12px] font-medium"
        >
          Cold storage
          <span class="font-data text-[10px] text-muted">1.53</span>
        </span>
        <span
          class="flex items-center justify-between px-2 py-1.5 text-[12px] text-muted"
        >
          Family vault
          <span class="font-data text-[10px]">0.62</span>
        </span>
        <span
          class="flex items-center justify-between px-2 py-1.5 text-[12px] text-muted"
        >
          Legacy xpub
          <span class="font-data text-[10px]">0.08</span>
        </span>
      </div>
      <span class="flex items-center gap-1.5 px-2 pb-1 text-[10px] text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-confirmed"></span>
        Synced &middot; 2 min ago
      </span>
    </div>

    <div class="min-w-0 flex-1 bg-background p-4 sm:p-5">
      <div class="flex items-center justify-between gap-3">
        <span class="font-display text-[16px] font-semibold">Cold storage</span>
        <span
          class="rounded-sm bg-sunken px-1.5 py-0.5 text-[10px] font-medium tracking-[0.04em] text-muted uppercase"
          >Watch-only</span
        >
      </div>
      <div class="mt-3">
        <span class="font-data text-[24px] font-medium tracking-[-0.01em]"
          >1.52840000 <span class="text-[14px] text-muted">BTC</span></span
        >
        <span class="mt-1 block font-data text-[11px] text-muted"
          >&asymp; 91,704 EUR &middot; synced 2 min ago</span
        >
      </div>
      <div class="card mt-4 overflow-hidden rounded-lg">
        {
          transactions.map((tx) => (
            <div class="flex h-11 items-center gap-2.5 border-b border-border px-3 last:border-b-0">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-sunken text-muted">
                <Icon
                  name={tx.direction === "in" ? "arrow-down-left" : "arrow-up-right"}
                  size={13}
                />
              </span>
              <span class="min-w-0 flex-1 truncate text-[13px]">
                {tx.label}
                <span class="ml-1.5 text-[11px] text-muted">{tx.date}</span>
              </span>
              <span
                class:list={[
                  "pill hidden !py-px !text-[10px] min-[420px]:inline-flex",
                  tx.status === "confirmed" ? "pill-confirmed" : "pill-pending",
                ]}
              >
                {tx.status === "confirmed" ? "Confirmed" : "Pending"}
              </span>
              <span class="font-data w-[86px] shrink-0 text-right text-[12px]">
                {tx.amount}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</figure>
