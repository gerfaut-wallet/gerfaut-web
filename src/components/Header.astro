---
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/download", label: "Download" },
  { href: "/premium", label: "Premium" },
  { href: "https://gerfaut-wallet.com/docs", label: "Docs" },
];
const itemClass =
  "inline-flex h-10 cursor-pointer items-center gap-1.5 rounded-md px-2.5 text-sm font-medium transition-colors duration-150 sm:px-3";
---

<header class="sticky top-0 z-30 border-b border-border bg-background">
  <div class="site-container flex h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="flex items-center gap-2.5 text-primary transition-colors duration-150 hover:text-primary-hover"
      aria-label="Gerfaut home"
    >
      <Mark class="h-5 w-auto" />
      <span
        class="hidden font-display text-sm font-extrabold tracking-[0.08em] uppercase sm:inline"
        >Gerfaut</span
      >
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-0.5 sm:gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={path === link.href ? "page" : undefined}
                class:list={[
                  itemClass,
                  path === link.href
                    ? "text-primary"
                    : "text-muted hover:bg-sunken hover:text-text",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="https://github.com/gerfaut-wallet"
            class:list={[itemClass, "text-muted hover:bg-sunken hover:text-text"]}
            aria-label="Gerfaut on GitHub"
          >
            <Icon name="github" size={16} />
            <span class="hidden md:inline">GitHub</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
