---
import Mark from "./Mark.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/download", label: "Download" },
  { href: "/premium", label: "Premium" },
  { href: "https://gerfaut-wallet.com/docs", label: "Docs", external: true },
];
---

<header class="sticky top-0 z-30 border-b border-border bg-background">
  <div
    class="mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-4 px-4 md:px-6"
  >
    <a
      href="/"
      class="flex items-center gap-2.5 text-primary transition-colors duration-150 hover:text-primary-hover"
      aria-label="Gerfaut home"
    >
      <Mark class="h-5 w-auto" />
      <span
        class="hidden font-display text-sm font-extrabold tracking-[0.08em] uppercase sm:inline"
        >Gerfaut</span
      >
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-1 sm:gap-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={path === link.href ? "page" : undefined}
                class:list={[
                  "inline-flex h-10 cursor-pointer items-center rounded-md px-2.5 text-sm font-medium transition-colors duration-150 sm:px-3",
                  path === link.href
                    ? "text-primary"
                    : "text-muted hover:bg-sunken hover:text-text",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
