---
import Mark from "./Mark.astro";
---

<footer class="dark-island border-t border-border bg-background text-text">
  <div class="mx-auto max-w-[1200px] px-4 py-12 md:px-6 md:py-16">
    <div class="grid gap-10 md:grid-cols-[1fr_auto_auto] md:gap-16">
      <div class="max-w-xs">
        <a
          href="/"
          class="inline-flex items-center gap-2.5 text-primary"
          aria-label="Gerfaut home"
        >
          <Mark class="h-5 w-auto" />
          <span
            class="font-display text-sm font-extrabold tracking-[0.08em] uppercase"
            >Gerfaut</span
          >
        </a>
        <p class="mt-3 text-sm text-muted">
          A Bitcoin watch-only wallet. It observes your wallets and never
          touches your keys.
        </p>
      </div>
      <nav aria-label="Product">
        <h2 class="text-label tracking-[0.04em] text-muted uppercase">
          Product
        </h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a
              href="/download"
              class="text-text transition-colors duration-150 hover:text-primary"
              >Download</a
            >
          </li>
          <li>
            <a
              href="/premium"
              class="text-text transition-colors duration-150 hover:text-primary"
              >Premium</a
            >
          </li>
          <li>
            <a
              href="https://gerfaut-wallet.com/docs"
              class="text-text transition-colors duration-150 hover:text-primary"
              >Documentation</a
            >
          </li>
        </ul>
      </nav>
      <nav aria-label="Project">
        <h2 class="text-label tracking-[0.04em] text-muted uppercase">
          Project
        </h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li>
            <a
              href="https://github.com/gerfaut-wallet"
              class="text-text transition-colors duration-150 hover:text-primary"
              >GitHub</a
            >
          </li>
          <li>
            <a
              href="https://www.gnu.org/licenses/agpl-3.0.html"
              class="text-text transition-colors duration-150 hover:text-primary"
              >License AGPL-3.0</a
            >
          </li>
          <li>
            <a
              href="mailto:info@pandul.fr"
              class="text-text transition-colors duration-150 hover:text-primary"
              >info@pandul.fr</a
            >
          </li>
        </ul>
      </nav>
    </div>
    <div
      class="mt-10 flex flex-col gap-2 border-t border-border pt-6 text-sm text-muted md:mt-12 md:flex-row md:items-center md:justify-between"
    >
      <p>&copy; {new Date().getFullYear()} Lo&iuml;c Morel</p>
      <p>
        The Gerfaut name and logo are not covered by the code license. See
        <a
          href="https://github.com/gerfaut-wallet/gerfaut-web/blob/main/TRADEMARK.md"
          class="text-text underline decoration-border underline-offset-2 transition-colors duration-150 hover:text-primary"
          >TRADEMARK.md</a
        >.
      </p>
    </div>
  </div>
</footer>
